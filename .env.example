# Public
NEXT_PUBLIC_STORE_NAME="MINE MC"
NEXT_PUBLIC_SERVER_IP="play.minemc.example"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/kT8WXQCaN5"
NEXT_PUBLIC_CURRENCY="INR"

# UPI checkout (static QR / UPI ID)
NEXT_PUBLIC_UPI_ID="6207867258@fam"
NEXT_PUBLIC_UPI_PAYEE="MINE MC"

# Admin secret used to manually verify a UPI payment and trigger delivery.
ADMIN_SECRET="replace-with-a-long-random-secret"

# PostgreSQL for production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/minemc?schema=public"

# Pterodactyl Client API (used to deliver verified purchases)
PTERO_PANEL_URL="https://panel.example.com"
PTERO_SERVER_ID="your-server-identifier"
PTERO_CLIENT_API_KEY="ptlc_xxxxxxxxxxxxxxxxx"

# Optional: choose the command syntax used by your permissions plugin.
# Available placeholders: {player}, {package}, {amount}, {orderId}
# Example LuckPerms: lp user {player} parent set {package}
MINECRAFT_RANK_COMMAND="lp user {player} parent set {package}"
MINECRAFT_COINS_COMMAND="eco give {player} {amount}"
MINECRAFT_KEY_COMMAND="crate give {player} {package} 1"
